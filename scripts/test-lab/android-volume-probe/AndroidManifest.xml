<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.dennomuso.koeon.volumeprobe">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
  <application android:label="KOEON Volume Input Probe" android:debuggable="true" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <service android:name=".VolumeKeyService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="KOEON Volume Input Probe">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/volume_service" />
    </service>
  </application>
</manifest>
